<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MathGame.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Label Text="Desafio Matemático"
                   FontSize="32" HorizontalOptions="Center" VerticalOptions="Start"/>
            
            <Image Source="mathlogo.png" Aspect="Center" 
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <Picker x:Name="pkDificuldade"
                    Title="Escolha a dificuldade"
                    SelectedIndexChanged="pkDificuldade_SelectedIndexChanged">
                <Picker.Items>
                    <x:String>Fácil</x:String>
                    <x:String>Médio</x:String>
                    <x:String>Difícil</x:String>
                </Picker.Items>
            </Picker>
            <Label x:Name="lbQuestao"
                   Text="Questão 1 de 10"
                   HorizontalOptions="Center"/>

            <Label x:Name="lbTempo"
                   Text="Tempo: 30"
                   HorizontalOptions="Center"

                   FontSize="22"/>

            <ProgressBar x:Name="pbProgresso"
                         Progress="0"/>
            
            <Label x:Name="lbPontos"
                   Text="Pontos: 0"
                   HorizontalOptions="Center"
                   FontSize="22"/>
            
            <Label Text="Resolva o desafio matemático abaixo:" FontSize="18"
                   HorizontalOptions="Center" VerticalOptions="Start"/>

            

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label x:Name="lb1" FontSize="30" Text="5"/>
                <Label x:Name="lb2" FontSize="30" Text="*"/>
                <Label x:Name="lb3" FontSize="30" Text="5"/>
            </HorizontalStackLayout>

            <Entry x:Name="txR" Placeholder="Digite a resposta aqui..." Keyboard="Numeric"/>

            <Button x:Name="btOK" Text="Conferir Resultado" Clicked="btOK_Clicked"/>

            <Image x:Name="imR"
                   Source="question.png"
                   Aspect="Center"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label x:Name="lbAcertou" FontSize="30" Text="Acertos: 0"/>
                <Label x:Name="lbErrou" FontSize="30" Text="Erros: 0"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>      
    </ScrollView>
</ContentPage>
